{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LexExamBench metadata-only index v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "exam_system",
          "year",
          "paper",
          "question_number",
          "question_type",
          "subject",
          "source_url",
          "answer_source_url",
          "provenance_grade",
          "rights",
          "law_time_status",
          "expert_review",
          "split",
          "accessed_at",
          "source_id",
          "business_category_mapping",
          "law_time_context",
          "current_law_review",
          "public_holdout_candidate",
          "revision",
          "provenance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "exam_system": {
            "enum": [
              "national-judicial-exam",
              "national-legal-qualification-exam"
            ]
          },
          "year": {
            "type": "integer",
            "minimum": 1986,
            "maximum": 2100
          },
          "paper": {
            "type": "string",
            "minLength": 1
          },
          "question_number": {
            "type": "string",
            "minLength": 1
          },
          "question_type": {
            "enum": [
              "single-choice",
              "multiple-choice",
              "indefinite-choice",
              "case-analysis",
              "essay"
            ]
          },
          "subject": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://[^ ]+$"
          },
          "answer_source_url": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^https://[^ ]+$"
              }
            ]
          },
          "provenance_grade": {
            "enum": [
              "official",
              "third-party",
              "recalled",
              "synthetic"
            ]
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_copy",
              "answer_copy",
              "storage",
              "redistribution",
              "external_model"
            ],
            "properties": {
              "question_copy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "answer_copy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "storage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "redistribution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "external_model": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            }
          },
          "law_time_status": {
            "const": "historical-review-pending"
          },
          "expert_review": {
            "const": "pending"
          },
          "split": {
            "const": "unassigned"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "business_category_mapping": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "const": "no-direct-mapping"
            }
          },
          "law_time_context": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "current_law_review": {
            "const": "pending"
          },
          "public_holdout_candidate": {
            "const": "unassigned"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "method",
              "locator",
              "revision"
            ],
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      }
    }
  }
}
