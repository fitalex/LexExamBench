{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "accessed_at",
          "answer_source_url",
          "provenance_grade",
          "rights",
          "publisher",
          "question_type",
          "access_result",
          "revision",
          "url",
          "exam_system",
          "year",
          "verification",
          "indexing"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "answer_source_url": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "pattern": "^https://[^ ]+$"
              }
            ]
          },
          "provenance_grade": {
            "enum": [
              "official",
              "third-party",
              "recalled",
              "synthetic"
            ]
          },
          "rights": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question_copy",
              "answer_copy",
              "storage",
              "redistribution",
              "external_model"
            ],
            "properties": {
              "question_copy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "answer_copy": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "storage": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "redistribution": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              },
              "external_model": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "evidence_url",
                  "basis"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "pending",
                      "verified",
                      "denied",
                      "not-applicable"
                    ]
                  },
                  "evidence_url": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^https://[^ ]+$"
                      }
                    ]
                  },
                  "basis": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  }
                }
              }
            }
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "question_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "access_result": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^ ]+$"
          },
          "exam_system": {
            "enum": [
              "national-judicial-exam",
              "national-legal-qualification-exam",
              "mixed-unverified"
            ]
          },
          "year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1986,
            "maximum": 2100
          },
          "verification": {
            "enum": [
              "unverified",
              "accessed-metadata-only",
              "verified-locator"
            ]
          },
          "indexing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "evidence_url",
              "basis"
            ],
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "verified",
                  "denied",
                  "not-applicable"
                ]
              },
              "evidence_url": {
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "pattern": "^https://[^ ]+$"
                  }
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              }
            }
          }
        }
      }
    }
  }
}
